{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "index.js",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "tests/**/*.js"
  ]
}

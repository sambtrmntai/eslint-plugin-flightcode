{
    "name": "@btrmnt/eslint-plugin-flightcode",
    "version": "0.2.0",
    "type": "module",
    "description": "Canonical FlightCode eslint flat-config (configs.recommended) + relaxZones() helper + Power-of-10 custom rules.",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.typecheck.json",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check:flightcode": "npm run typecheck && npm run lint && npm run format:check",
        "check:flightcode:strict": "npm run typecheck && eslint . --max-warnings 0 && npm run format:check"
    },
    "peerDependencies": {
        "eslint": "^9.39.4",
        "typescript-eslint": "^8.62.1"
    },
    "dependencies": {
        "@eslint/js": "^9.39.4",
        "@typescript-eslint/utils": "^8.63.0",
        "eslint-plugin-eslint-comments": "^3.2.0",
        "eslint-plugin-jsdoc": "^63.0.10",
        "typescript-eslint": "^8.62.1"
    },
    "devDependencies": {
        "@typescript-eslint/rule-tester": "^8.63.0",
        "eslint": "^9.39.4",
        "prettier": "^3.3.3",
        "typescript": "^5.4.5",
        "vitest": "^1.6.0"
    }
}

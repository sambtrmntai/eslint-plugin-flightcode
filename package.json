        "eslint-plugin-eslint-comments": "^3.2.0",
        "typescript-eslint": "^8.62.1"
    },
    "devDependencies": {
        "eslint": "^9.39.4",
        "typescript": "^5.4.5",
        "vitest": "^1.6.0",
        "prettier": "^3.3.3"
    }
